{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ariane.toml",
  "description": "Configuration of Ariane for one repository.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "tracker",
    "agents",
    "checks"
  ],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_branch"
      ],
      "properties": {
        "base_branch": {
          "type": "string",
          "minLength": 1,
          "description": "Branch the pull requests target."
        },
        "setup": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Command run once in the working tree (list of arguments)."
        },
        "env": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [],
          "description": "Variables agents, checks and setup commands receive beyond the base set (ADR 0024); an entry ending in _ is a prefix."
        },
        "parallel_checks": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 1,
          "description": "Checks replayed at the same time, each in its own tree and run slot (ADR 0052); 1 replays them one by one."
        },
        "check_all_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Path globs, such as lock files and CI files, whose change selects every check (as a change to ariane.toml does)."
        },
        "cache": {
          "type": "array",
          "description": "Dependency folders kept by the content of their key files (ADR 0054): a replay tree copies a stored folder instead of running its setup; project.setup then runs for what the caches do not cover.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "key",
              "setup"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Folder relative to the tree, such as node_modules or .venv; git must ignore it."
              },
              "key": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Files whose content identifies the folder, such as the lock file; with setup, they make the key."
              },
              "setup": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Command that builds that folder alone (list of arguments), run on a miss."
              },
              "keep": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "default": 5,
                "description": "Most recently used entries of this path kept; older ones are removed at the start of a ticket."
              }
            }
          }
        }
      }
    },
    "tracker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "repository",
        "token_env"
      ],
      "properties": {
        "kind": {
          "enum": [
            "github"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "owner/name"
        },
        "token_env": {
          "type": "string",
          "minLength": 1,
          "description": "Environment variable holding the token."
        },
        "api_url": {
          "type": "string",
          "minLength": 1,
          "default": "https://api.github.com",
          "description": "https URL (plain http only to the local machine)."
        },
        "ready_label": {
          "type": "string",
          "minLength": 1,
          "default": "ariane",
          "description": "Label a person with write access puts on an issue to let Ariane run it."
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementer",
        "reviewer"
      ],
      "properties": {
        "implementer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtime",
            "model",
            "tools",
            "max_budget_usd",
            "timeout_minutes"
          ],
          "properties": {
            "runtime": {
              "enum": [
                "claude-code"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "tools": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Tools the agent may use (not Skill)."
            },
            "max_budget_usd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_tokens": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "Cap on tokens counted by Ariane per session; required when runtime is opencode or pi."
            },
            "timeout_minutes": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "idle_minutes": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Stop the session when no event arrives for this many minutes; below timeout_minutes. Default 10, or none when timeout_minutes is 10 or less."
            },
            "api_key_env": {
              "type": "string",
              "minLength": 1,
              "description": "Codex or pi reviewer only: variable holding an API key, passed to the session as CODEX_API_KEY (Codex) or as the model provider's own key variable (pi); without it the CLI's own login is used."
            }
          }
        },
        "reviewer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtime",
            "model",
            "tools",
            "max_budget_usd",
            "timeout_minutes"
          ],
          "properties": {
            "runtime": {
              "enum": [
                "claude-code",
                "opencode",
                "codex",
                "pi"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "tools": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Tools the agent may use (not Skill)."
            },
            "max_budget_usd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_tokens": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "Cap on tokens counted by Ariane per session; required when runtime is opencode or pi."
            },
            "timeout_minutes": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "idle_minutes": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Stop the session when no event arrives for this many minutes; below timeout_minutes. Default 10, or none when timeout_minutes is 10 or less."
            },
            "api_key_env": {
              "type": "string",
              "minLength": 1,
              "description": "Codex or pi reviewer only: variable holding an API key, passed to the session as CODEX_API_KEY (Codex) or as the model provider's own key variable (pi); without it the CLI's own login is used."
            },
            "small": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_lines"
              ],
              "description": "Settings replacing the reviewer's for a change of at most max_lines changed lines (added plus deleted, without work/; a binary file counts 0); the prompt asks for a narrower review. The model, when given, differs from the implementer's (C10).",
              "properties": {
                "max_lines": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "max_budget_usd": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "max_tokens": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "timeout_minutes": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "type": "object",
                "properties": {
                  "runtime": {
                    "enum": [
                      "opencode",
                      "pi"
                    ]
                  }
                },
                "required": [
                  "runtime"
                ]
              },
              "then": {
                "type": "object",
                "required": [
                  "max_tokens"
                ]
              }
            },
            {
              "if": {
                "type": "object",
                "properties": {
                  "runtime": {
                    "const": "claude-code"
                  }
                },
                "required": [
                  "runtime"
                ]
              },
              "then": {
                "type": "object",
                "properties": {
                  "tools": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "Read",
                        "Glob",
                        "Grep"
                      ]
                    },
                    "description": "A Claude Code reviewer: Read, Glob, Grep only"
                  }
                }
              }
            },
            {
              "if": {
                "type": "object",
                "properties": {
                  "runtime": {
                    "const": "pi"
                  }
                },
                "required": [
                  "runtime"
                ]
              },
              "then": {
                "type": "object",
                "properties": {
                  "tools": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "read",
                        "grep",
                        "find",
                        "ls"
                      ]
                    },
                    "description": "A pi reviewer: read, grep, find, ls only"
                  }
                }
              }
            }
          ],
          "description": "Read-only reviewer (C10); model differs from the implementer."
        }
      }
    },
    "definition_of_done": {
      "type": "object",
      "additionalProperties": false,
      "description": "What a change must satisfy to be done (C26); optional.",
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "check"
                ],
                "properties": {
                  "check": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Name of a declared check."
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "description": "A sentence to satisfy."
                  }
                }
              }
            ]
          },
          "description": "Default: tests pass, tests cover the change, docs updated."
        }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "description": "The project's documentation (C25); optional.",
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Documentation files and folders, for `ariane docs-review`."
        },
        "map": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "docs"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "description": "Glob of source files."
              },
              "docs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Documents covering them; {stem} is the matched file's name without extension."
              }
            }
          }
        },
        "generated": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "check"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Unique name; the check is `docs: <name>`."
              },
              "check": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Command exiting non-zero when a generated document is stale (list of arguments)."
              }
            }
          }
        }
      }
    },
    "checks_policy": {
      "type": "object",
      "additionalProperties": false,
      "description": "What makes a round's risk tier high (ADR 0056); without this table every round is high.",
      "properties": {
        "max_changed_lines": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 300,
          "description": "More added plus removed lines than this is high."
        },
        "max_modules": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 3,
          "description": "More modules touched than this is high."
        },
        "module_roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Globs of the folders whose children count as modules, such as \"src/*/\"; by default the repository root."
        },
        "critical_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Path globs whose change makes the round high."
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command"
        ],
        "not": {
          "type": "object",
          "required": [
            "paths",
            "always"
          ]
        },
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Unique name of the check."
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Command to run (list of arguments)."
          },
          "blocking": {
            "type": "boolean",
            "default": true
          },
          "timeout_minutes": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 15
          },
          "setup": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Replaces project.setup in this check's replay tree."
          },
          "not_run_locally": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Path globs of the files whose tests this check skips when Ariane replays it (only CI runs them)."
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Path globs of the files the check covers: Ariane skips it when no changed file of the ticket matches. Not with always."
          },
          "always": {
            "const": true,
            "description": "The check runs whatever changed (the default without paths). Not with paths."
          },
          "full_when": {
            "enum": [
              "high",
              "always"
            ],
            "default": "high",
            "description": "When the check gets ARIANE_FULL_SUITE=1: on a high risk tier only (the default), or always (ADR 0056)."
          }
        }
      }
    }
  }
}
